# Copy this file to ".env" and fill in your key. Never share or upload the .env file.

# Your LLM API key. The defaults below use Google's Gemini API,
# which has a free tier: get a key at https://aistudio.google.com/app/apikey
LLM_API_KEY=paste-your-key-here

# Any OpenAI-compatible API works. Change these two lines to switch provider.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
